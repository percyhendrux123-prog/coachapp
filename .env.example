# Frontend (Vite). Copy to .env for local development and set the same names in your
# Netlify site's environment variables. Everything prefixed VITE_ is compiled into the
# public bundle, so only public values belong here. Never put a secret key in a VITE_ var.

# Supabase project URL and anon (public) key: Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public half of the Web Push (VAPID) key pair. The private half is a Supabase secret only.
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Optional. Defaults to <your site>/mcp at runtime. Set only to test a tunnelled MCP endpoint.
VITE_MCP_ENDPOINT=

# Optional. Name shown when a tenant has not set its own app name. Default: Coach App.
VITE_APP_NAME=

# Optional. Booking link for coaching applications (for example a Cal.com page).
# Empty hides the link.
VITE_COACHING_APPLICATION_URL=

# Optional. Stripe price ids used by the public coaching pages.
VITE_STRIPE_PRICE_ENTRY=
VITE_STRIPE_PRICE_STANDARD=

# There is deliberately no VITE_SITE_URL. The sign-in return address is read from
# window.location.origin at runtime (src/context/AuthContext.jsx). vite.config.js fails the
# build if a loopback address reaches a production chunk.

# -----------------------------------------------------------------------------------------
# Edge function secrets (Supabase). NOT read from this file. Set them with:
#   supabase secrets set NAME=value
# Listed here so the whole configuration is documented in one place.
# -----------------------------------------------------------------------------------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY   provided by Supabase automatically
# APP_ORIGIN=https://app.example.com          public URL of the frontend (email links, redirects)
# ALLOWED_ORIGINS=app.example.com             comma-separated hostnames allowed as checkout return URLs
# CRON_SECRET=                                shared bearer for scheduled and server-to-server calls
# RESEND_API_KEY=                             email delivery (Resend). Unset = email steps fail with "RESEND_API_KEY not set"
# EMAIL_FROM="Coach App <no-reply@example.com>"   default sender
# COACHING_EMAIL_FROM= SYSTEM_EMAIL_FROM= DIGEST_SENDER=   optional per-flow senders (fall back to EMAIL_FROM)
# DIGEST_RECIPIENT=                           platform owner's ops inbox. Unset = digest is skipped
# COACH_SIGNATURE="Your coach"                sign-off line in onboarding emails
# PLATFORM_NAME="Coach App"                   name used in white-label billing notices
# VAPID_PUBLIC_KEY= VAPID_PRIVATE_KEY=        Web Push key pair
# VAPID_SUBJECT=mailto:admin@example.com
# STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=   Stripe API key and webhook signing secret
# STRIPE_PRICE_ENTRY= STRIPE_PRICE_STANDARD=  coaching tier prices
# STRIPE_PRODUCTS_ENTRY= STRIPE_PRODUCTS_STANDARD=   comma-separated product ids per tier
# STRIPE_PRICE_LICENSE=                       one-time white-label license price
# STRIPE_PRICE_HOSTING=                       monthly hosting price for white-label coaches
# STRIPE_PRICE_SELF_SERVE=                    one-time self-serve plan price
#   An unset Stripe price makes that checkout path refuse with a clear error.
# ANTHROPIC_API_KEY=                          optional: check-in read generator (checkin-assess)
# YOUTUBE_API_KEY=                            optional: video title/description lookup
#
# Database vault secrets (Supabase SQL editor), used by scheduled jobs and the coach-push trigger:
#   select vault.create_secret('https://your-project-ref.supabase.co', 'project_url');
#   select vault.create_secret('<same value as CRON_SECRET>', 'cron_reconcile_bearer');
#
# Netlify function (netlify/functions/mcp-oauth.mjs), set in Netlify site settings:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# OAUTH_ISSUER=https://app.example.com
#
# Deploy helper (scripts/deploy-function.mjs), set in your shell:
# SUPABASE_PROJECT_REF=your-project-ref
